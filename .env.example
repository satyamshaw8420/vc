# ============================================================
# SkillSignal Sessions — environment template
# Copy to `.env` and fill in. `.env` must stay OUT of git.
# ============================================================

# ---- Token server (Node — token-server.mjs) ----------------
# Public key: safe for frontend too.
STREAM_API_KEY=pge5uhef9ux4
# SECRET — never commit, never ship to the browser bundle.
STREAM_SECRET_KEY=paste-your-secret-here
# dev  → devToken (Stream "Development" environment, auth checks off)
# prod → createToken with 1h expiry
STREAM_MODE=dev
PORT=8002

# ---- Frontend (Vite — must start with VITE_) ---------------
# URL of the deployed/local token server.
VITE_TOKEN_URL=http://localhost:8002
# Public API key (same as above) — safe to expose.
VITE_STREAM_API_KEY=pge5uhef9ux4
